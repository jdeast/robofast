{
  "_note": [
    "Synthetic example request groups for MINERVA's dispatch scheduler (robofast_core/request_model.py).",
    "The legacy MINERVA target lists are not in the public minerva-control repository, so these are",
    "illustrative: well-known RV-standard stars (J2000 coordinates, rounded) in the legacy shape --",
    "standing requests at least 3 h apart, at most 2 visits a night (the legacy seplimit and maxobs",
    "defaults) -- plus a telluric B star and a one-shot imaging request for T2.",
    "Convert a real legacy targets.csv with robofast_core.request_model.from_legacy_csv, or name it",
    "as 'legacy_csv' in the dispatch plan entry (sites/minerva/dispatch.example.json)."
  ],
  "groups": [
    {"id": "HD10700", "name": "HD 10700", "proposal": "rv-example", "priority": 5,
     "requests": [{"id": "HD10700-rv", "cadence": {"min_interval": 10800, "max_per_night": 2},
       "configurations": [{"id": "HD10700-rv-spec", "instrument": "spectrograph",
         "target": {"name": "HD 10700", "ra_hours": 1.734467, "dec_deg": -15.937478},
         "instrument_configs": [{"exptime": 300, "count": 3}]}]}]},
    {"id": "HD4628", "name": "HD 4628", "proposal": "rv-example", "priority": 3,
